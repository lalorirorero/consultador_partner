# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno del Buscador de RUTs (Zoho Analytics)
# Copia este archivo a .env.local y complétalo. En Vercel, cárgalas en
# Project Settings → Environment Variables. NUNCA subas valores reales al repo.
# ─────────────────────────────────────────────────────────────────────────────

# Data center de la cuenta de Zoho: com / eu / in / com.au / jp
ZOHO_DC=com

# Credenciales OAuth del Self Client (https://api-console.zoho.com)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ORG ID de Zoho Analytics (cabecera ZANALYTICS-ORGID)
ZOHO_ORG_ID=

# Identificadores del workspace y de la vista (tabla) — ya conocidos
ZOHO_WORKSPACE_ID=1943489000000004001
ZOHO_VIEW_ID=1943489000048875306

# Nombres EXACTOS de las columnas en la tabla de Zoho Analytics
# (confirmar tal como aparecen en el editor de la vista)
ZOHO_RUT_COLUMN=
ZOHO_NAME_COLUMN=
